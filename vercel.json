{
  "functions": {
    "api/contact.php": { "runtime": "vercel-php@0.7.2" },
    "index.php": { "runtime": "vercel-php@0.7.2" },
    "project-details.php": { "runtime": "vercel-php@0.7.2" },
    "includes/header.php": { "runtime": "vercel-php@0.7.2" },
    "includes/footer.php": { "runtime": "vercel-php@0.7.2" },
    "data/projects.php": { "runtime": "vercel-php@0.7.2" }
  },
  "routes": [
    { "src": "/", "dest": "/index.php" },
    { "src": "/project-details(.*)", "dest": "/project-details.php$1" },
    { "src": "/api/contact", "dest": "/api/contact.php" },
    { "src": "/(.*\\.(css|js|jpg|jpeg|png|gif|svg|webp|pdf|glb|ico|woff|woff2|ttf))", "dest": "/$1" }
  ]
}
